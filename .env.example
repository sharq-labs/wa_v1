APP_NAME="WhatsFlow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whats_v1
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@whatsflow.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=whatsflow
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# WhatsApp provider: fake | meta
WHATSAPP_PROVIDER=fake
WHATSAPP_SERVICE_WINDOW_HOURS=24
# Comma-separated system consent keywords. Extend these per market/language.
WHATSAPP_OPT_IN_KEYWORDS="start,subscribe,اشترك,ابدأ"
WHATSAPP_OPT_OUT_KEYWORDS="stop,unsubscribe,توقف,إلغاء الاشتراك,الغاء الاشتراك"
# Use an S3-compatible disk in production if media must be provider-accessible.
WHATSAPP_MEDIA_DISK=public

# Meta WhatsApp Business Platform
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=local-verify-token
META_GRAPH_API_VERSION=v21.0
META_REDIRECT_URI="${APP_URL}/api/meta/oauth/callback"

# Public company/compliance identity used by Meta App Review pages.
# Fill these with the same legal/business details used in Meta Business Portfolio.
COMPLIANCE_COMPANY_NAME="${APP_NAME}"
COMPLIANCE_LEGAL_NAME=
COMPLIANCE_COMPANY_ADDRESS=
COMPLIANCE_SUPPORT_EMAIL="${MAIL_FROM_ADDRESS}"
COMPLIANCE_PRIVACY_EMAIL="${COMPLIANCE_SUPPORT_EMAIL}"
COMPLIANCE_SUPPORT_URL=

# Automation engine safety
MAX_AUTOMATION_STEPS=200
MAX_AUTOMATION_DEPTH=5
AUTOMATION_HTTP_TIMEOUT=10
AUTOMATION_HTTP_MAX_RESPONSE=524288

# Platform billing provider: manual | paymob
BILLING_PROVIDER=manual
# Keep disabled in production unless payment is collected outside the platform.
BILLING_ALLOW_MANUAL_SELF_SERVICE=false

# Paymob (Egypt hosted checkout / Intention API)
# Test and live use Paymob's regional host; credentials determine the environment.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated Paymob payment method / integration IDs enabled for checkout.
PAYMOB_PAYMENT_METHOD_IDS=
PAYMOB_INTENTION_URL=https://accept.paymob.com/v1/intention/
PAYMOB_CHECKOUT_URL=https://accept.paymob.com/unifiedcheckout
PAYMOB_WEBHOOK_URL="${APP_URL}/api/webhooks/paymob/transaction"
PAYMOB_RETURN_URL="${APP_URL}/settings/billing"
PAYMOB_TIMEOUT=15
